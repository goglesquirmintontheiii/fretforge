{
  "name": "@fretforge/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Fretforge desktop app",
  "author": "Fretforge",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
