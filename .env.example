# Fretforge server settings (Docker, `npm start`). The desktop app sets these itself.

# "server" asks for an owner password on first visit; "desktop" is for the Electron shell only.
FRETFORGE_MODE=server
# Address and port to listen on.
FRETFORGE_HOST=0.0.0.0
FRETFORGE_PORT=7700
# App data: db.json, converted scores, downloaded tabs.
FRETFORGE_DATA=./data
# Watched folder with your Guitar Pro / MusicXML / MIDI files (can be changed in Settings).
FRETFORGE_LIBRARY=./library
# Built web app to serve (packages/web/dist). Leave unset in development (Vite serves it).
FRETFORGE_STATIC=./packages/web/dist
# Poll the library folder instead of using file events (needed for NFS/SMB shares and some Docker setups).
FRETFORGE_POLL=0
# Add the demo songs to an empty library (0 = no).
FRETFORGE_DEMOS=1
# Request logging (1 = on).
FRETFORGE_LOG=0
